{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Price Truth Dataset",
  "description": "An array of reported service prices in Bangalore. No personal data, no provider names.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "serviceType", "cityArea", "priceInr", "dateOfService", "sourceType", "confidence"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "description": "Unique record identifier."
      },
      "serviceType": {
        "type": "string",
        "enum": [
          "plumber-visit",
          "electrician-visit",
          "carpenter-visit",
          "house-cleaning",
          "ac-service",
          "pest-control",
          "painting-per-sqft",
          "washing-machine-repair"
        ],
        "description": "The type of local service."
      },
      "cityArea": {
        "type": "string",
        "minLength": 1,
        "description": "Neighbourhood or area within the city. Must not contain personal data."
      },
      "priceInr": {
        "type": "integer",
        "minimum": 1,
        "description": "Price paid in INR. Upper bounds are defined per service type in config."
      },
      "dateOfService": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date the service was performed, YYYY-MM-DD."
      },
      "sourceType": {
        "type": "string",
        "enum": ["self-reported", "operator-collected", "published-rate-card"],
        "description": "How this price was collected."
      },
      "confidence": {
        "type": "string",
        "enum": ["high", "medium", "low"],
        "description": "Confidence level in this data point."
      },
      "note": {
        "type": "string",
        "description": "Optional free-text note. Must not contain personal data (names, phone numbers, emails, business names)."
      }
    }
  }
}
